    <script>
        // Define beautiful, high-contrast color pairs (only the ACCENT color is needed here)
        const accentColors = [
            "#3b82f6", // Blue
            "#10b981", // Emerald Green
            "#f59e0b", // Amber
            "#ef4444", // Red
            "#8b5cf6", // Violet
            "#06b6d4", // Cyan
        ];
        let colorIndex = 0;

        // Function to apply colors
        function applyColors() {
            const currentAccent = accentColors[colorIndex];
            const root = document.documentElement.style;

            // Update the CSS Variable which Tailwind classes are configured to use
            root.setProperty('--accent-color', currentAccent);

            // Cycle index
            colorIndex = (colorIndex + 1) % accentColors.length;
        }

        // Apply colors immediately on load
        applyColors();

        // Change colors automatically every 4 seconds (4000 milliseconds)
        // This gives a modern, dynamic effect to the accent elements
        setInterval(applyColors, 4000);
    </script>
